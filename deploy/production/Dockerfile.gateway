# nginx:1.30.4 includes the 2026-07-15 stable security fixes.
# Docker Hub linux/amd64 manifest digest queried on 2026-07-16.
FROM nginx:1.30.4-alpine3.24@sha256:8a4f4b94275ff59d809477799cbbaf1a7ab65ed1871403d05e31fd66bdb8db82

COPY --chown=101:101 deploy/production/nginx.conf /etc/nginx/nginx.conf

RUN /usr/sbin/nginx -t

USER 101:101
EXPOSE 8065
STOPSIGNAL SIGQUIT

ENTRYPOINT ["/usr/sbin/nginx"]
CMD ["-g", "daemon off;"]
