# Non-secret production settings. bootstrap.sh copies this file to .env (mode 0600).
COMPOSE_PROJECT_NAME=iuin
DATA_ROOT=/srv/iuin

# The service is intentionally bound only to the current LAN address.
BIND_ADDRESS=10.22.111.16
PUBLISH_INTERFACE=enp65s0f0
LAN_CIDR=10.0.0.0/8
SITE_URL=http://10.22.111.16:8065
SMTP_UI_URL=http://10.22.111.16:8025
TZ=Asia/Shanghai

POSTGRES_DB=mattermost
POSTGRES_USER=mattermost
MINIO_BUCKET=mattermost
MINIO_REGION=us-east-1

ADMIN_USERNAME=litangchao
ADMIN_EMAIL=123090284@link.cuhk.edu.cn

# SMTP is captured by the private Mailpit container and is not relayed externally.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Bind SMTP only on Mailpit's internal network, never on its UI network.
SMTP_PRIVATE_ADDRESS=172.30.0.2
SMTP_PRIVATE_SUBNET=172.30.0.0/24
SMTP_FROM_NAME=IUIN
SMTP_FROM_ADDRESS=mattermost@iuin.test
SMTP_REPLY_TO_ADDRESS=no-reply@iuin.test
SMTP_SUPPORT_ADDRESS=support@iuin.test

SERVER_IMAGE=iuin-server:11.8.3
MINIO_IMAGE=iuin-minio:RELEASE.2025-10-15T17-29-55Z

SERVER_CPUS=16.0
SERVER_MEMORY=16g
POSTGRES_CPUS=8.0
POSTGRES_MEMORY=8g
MINIO_CPUS=8.0
MINIO_MEMORY=8g
MAILPIT_CPUS=2.0
MAILPIT_MEMORY=1g

MAILPIT_MAX_MESSAGES=1000
MAILPIT_MAX_AGE=14d
MAILPIT_MAX_MESSAGE_SIZE=25
MAILPIT_SMTP_MAX_RECIPIENTS=50

BACKUP_RETENTION_DAYS=14
