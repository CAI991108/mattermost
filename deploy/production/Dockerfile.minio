# syntax=docker/dockerfile:1.12

ARG GO_IMAGE=golang:1.24.6-alpine3.22@sha256:c8c5f95d64aa79b6547f3b626eb84b16a7ce18a139e3e9ca19a8c078b85ba80d
ARG RUNTIME_IMAGE=alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

FROM ${GO_IMAGE} AS builder
RUN apk add --no-cache bash ca-certificates git

ARG MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
ARG MINIO_RELEASE_TIME=2025-10-15T17:29:55Z
WORKDIR /src
RUN git clone --branch "${MINIO_TAG}" --depth 1 https://github.com/minio/minio.git . \
    && test "$(git rev-parse HEAD)" = "${MINIO_COMMIT}"

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
        -tags kqueue \
        -trimpath \
        -ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go "${MINIO_RELEASE_TIME}")" \
        -o /out/minio . \
    && /out/minio --version | grep -F "${MINIO_TAG}"

FROM ${RUNTIME_IMAGE} AS runtime
RUN addgroup -S -g 1000 minio \
    && adduser -S -D -H -u 1000 -G minio minio \
    && mkdir -p /data \
    && chown 1000:1000 /data \
    && chmod 0700 /data

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder --chown=1000:1000 /out/minio /usr/local/bin/minio
COPY --from=builder /src/LICENSE /licenses/LICENSE
COPY --chown=1000:1000 deploy/production/minio-entrypoint.sh /usr/local/bin/iuin-minio-entrypoint
RUN chmod 0755 /usr/local/bin/minio /usr/local/bin/iuin-minio-entrypoint

USER 1000:1000
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/iuin-minio-entrypoint"]
CMD ["server", "/data", "--address", ":9000", "--console-address", ":9001"]

EXPOSE 9000/tcp 9001/tcp
